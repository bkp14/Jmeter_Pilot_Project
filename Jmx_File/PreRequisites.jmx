            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="employeeDetails_PreProcessor" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import java.util.Random

Random rand = new Random()

String[] firstNames = [&quot;Arun&quot;,&quot;Vijay&quot;,&quot;Karthik&quot;,&quot;Rahul&quot;,&quot;Ajay&quot;]
String[] middleNames = [&quot;Kumar&quot;,&quot;Raj&quot;,&quot;Prasad&quot;,&quot;Dev&quot;,&quot;Sai&quot;]
String[] lastNames = [&quot;Sharma&quot;,&quot;Patel&quot;,&quot;Rao&quot;,&quot;Singh&quot;,&quot;Gupta&quot;]

String suffix = String.valueOf(1000 + rand.nextInt(9000))

vars.put(&quot;firstName&quot;, firstNames[rand.nextInt(firstNames.length)] + suffix)
vars.put(&quot;middleName&quot;, middleNames[rand.nextInt(middleNames.length)])
vars.put(&quot;lastName&quot;, lastNames[rand.nextInt(lastNames.length)])
vars.put(&quot;employeeId&quot;, suffix)</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Emp_Number_JSON Extractor" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">empNumber</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.data.empNumber</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">empNumber_notFound</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import java.io.File
import java.io.FileWriter

File file = new File(&quot;E:/JMeter_Pilot_Project_OrangeHRM/test-data/empnumber.csv&quot;)
file.getParentFile().mkdirs()

String empNumber = vars.get(&quot;empNumber&quot;)

// Don&apos;t write invalid values
if (empNumber != null &amp;&amp;
    !empNumber.trim().isEmpty() &amp;&amp;
    empNumber != &quot;empNumber_notFound&quot;) {

    synchronized (this.class) {

        if (!file.exists()) {
            file.createNewFile()
        }

        boolean isNewFile = (file.length() == 0)

        FileWriter writer = new FileWriter(file, true)

        try {
            if (!isNewFile) {
                writer.write(System.lineSeparator())
            }

            writer.write(empNumber.trim())
            writer.flush()

        } finally {
            writer.close()
        }
    }
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="TestPlan.comments">Storing generated EmpNumber</stringProp>
            </JSR223PostProcessor>

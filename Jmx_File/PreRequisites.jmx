            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="EmployeeID_preprocessor" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">// Creates a unique ID combining timestamp and thread number
String empId = &quot;EMP&quot; + System.currentTimeMillis().toString().substring(9) + ctx.getThreadNum()
vars.put(&quot;employeeId&quot;, empId)</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="EmployeeData_POSTPROCESSOR" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.io.File
import java.io.FileWriter

File file = new File(&quot;E:/JMeter_Pilot_Project_OrangeHRM/test-data/empnumber1.csv&quot;)
file.getParentFile().mkdirs()

String empNumber = vars.get(&quot;empNumber&quot;)

// Don&apos;t write invalid values
if (empNumber != null &amp;&amp;
    !empNumber.trim().isEmpty() &amp;&amp;
    empNumber != &quot;empNumber_notFound&quot;) {

    synchronized (this.class) {

        if (!file.exists()) {
            file.createNewFile()
        }

        boolean isNewFile = (file.length() == 0)

        FileWriter writer = new FileWriter(file, true)

        try {
            if (!isNewFile) {
                writer.write(System.lineSeparator())
            }

            writer.write(empNumber.trim())
            writer.flush()

        } finally {
            writer.close()
        }
    }
}</stringProp>
            </JSR223PostProcessor>

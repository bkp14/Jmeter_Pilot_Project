            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.io.File

String filePath = &quot;E:/JMeter_Pilot_Project_OrangeHRM/test-data/admin_users.csv&quot;

File file = new File(filePath)
file.getParentFile().mkdirs()

// Create header only once
if (!file.exists()) {
    file.write(&quot;username,password,empNumber\n&quot;)
}

String username = vars.get(&quot;username&quot;)
String password = vars.get(&quot;password&quot;)
String empNumber = vars.get(&quot;empNumber&quot;)

if (username &amp;&amp; password &amp;&amp; empNumber) {
    file.append(&quot;${username},${password},${empNumber}${System.lineSeparator()}&quot;)
}</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// Generate unique username based on thread number
String username = &quot;admin&quot; + (ctx.getThreadNum() + 1)

// Password (same for all admins)
String password = &quot;admin321&quot;

vars.put(&quot;username&quot;, username)
vars.put(&quot;password&quot;, password)</stringProp>
            </JSR223PreProcessor>

2026-07-30 17:12:15,943 DEBUG o.a.j.t.TestBeanHelper: Setting script=import java.time.DayOfWeek
import java.time.LocalDate

String response = prev.getResponseDataAsString()
String responseCode = prev.getResponseCode()

int currentRetry = (vars.get("retry") ?: "0").toInteger()

if (responseCode == "200" || responseCode == "201") {
    vars.put("success", "true")
} 
else if (response.contains("Overlapping Leave Request Found") || response.contains("No Working Days Selected")) {
    
    LocalDate nextDate = LocalDate.parse(vars.get("fromDate")).plusDays(1)
    

    if (nextDate.getDayOfWeek() == DayOfWeek.SATURDAY) {
        nextDate = nextDate.plusDays(2)
    } else if (nextDate.getDayOfWeek() == DayOfWeek.SUNDAY) {
        nextDate = nextDate.plusDays(1)
    }

    vars.put("fromDate", nextDate.toString())
    vars.put("toDate", nextDate.toString())
    vars.put("retry", (currentRetry + 1).toString())
} 
else {

    vars.put("success", "true") 
}

    &quot;duration&quot;: {&#xd;
        &quot;type&quot;: &quot;half_day_morning&quot;&#xd;
    }&#xd;
}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>

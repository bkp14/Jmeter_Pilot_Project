import java.time.DayOfWeek
import java.util.concurrent.ThreadLocalRandom


int randomOffsetDays = ThreadLocalRandom.current().nextInt(1, 31)
LocalDate randomDate = LocalDate.now().plusDays(randomOffsetDays)


if (randomDate.getDayOfWeek() == DayOfWeek.SATURDAY) {
    randomDate = randomDate.plusDays(2)
} else if (randomDate.getDayOfWeek() == DayOfWeek.SUNDAY) {
    randomDate = randomDate.plusDays(1)
}


vars.put("success", "false")
vars.put("retry", "0")
vars.put("fromDate", randomDate.toString())
vars.put("toDate", randomDate.toString())


SampleResult.setIgnore()
